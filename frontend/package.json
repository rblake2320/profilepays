{
  "name": "profilepays-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "ProfilePays frontend application built with React",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --resolve-plugins-relative-to ..",
    "lint:fix": "npm run lint -- --fix",
    "test": "ts-node --transpile-only --project tsconfig.tests.json tests/run-tests.ts",
    "test:ui": "npm test",
    "test:coverage": "npm test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.10.0",
    "@emotion/styled": "^11.10.0",
    "@hookform/resolvers": "^2.9.11",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^5.11.0",
    "@reduxjs/toolkit": "^1.9.7",
    "axios": "^1.16.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.76.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^7.11.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "@typescript-eslint/parser": "^5.52.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "c8": "^7.12.0",
    "eslint": "^8.34.0",
    "eslint-plugin-react": "^7.32.0",
